# Ferretería Los Maestros - Backend Environment Variables
# Copia este archivo a .env y completa los valores

# JWT Configuration (GENERA UNO SEGURO: openssl rand -base64 32)
# En desarrollo puede omitirse (application-dev.properties usa un secreto local).
# En producción es OBLIGATORIO definir JWT_SECRET antes de arrancar.
JWT_SECRET=  # openssl rand -base64 32
JWT_ISSUER_URI=http://localhost:8081
JWT_JWK_SET_URI=http://localhost:8081/.well-known/jwks.json

# Database
DB_USER=ferreteria
DB_PASS=
DB_URL=jdbc:postgresql://localhost:5432/ferreteria_product
DB_AUTH_URL=jdbc:postgresql://localhost:5431/ferreteria_auth
DB_PRODUCT_URL=jdbc:postgresql://localhost:5432/ferreteria_product
DB_ORDER_URL=jdbc:postgresql://localhost:5433/ferreteria_order
DB_USER_URL=jdbc:postgresql://localhost:5437/ferreteria_user
DB_CATALOG_URL=jdbc:postgresql://localhost:5435/ferreteria_catalog
DB_CART_URL=jdbc:postgresql://localhost:5436/ferreteria_cart

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=ferreteria
RABBITMQ_PASS=

# Credencial compartida para llamadas internas HTTP
INTERNAL_API_SECRET=

# Service URLs (para comunicación entre servicios)
CATALOG_SERVICE_URL=http://localhost:8085
PRODUCT_SERVICE_URL=http://localhost:8082

# Server ports (opcional, tienen defaults)
# AUTH_SERVICE_PORT=8081
# PRODUCT_SERVICE_PORT=8082
# ORDER_SERVICE_PORT=8083
# USER_SERVICE_PORT=8084
# CATALOG_SERVICE_PORT=8085
# CART_SERVICE_PORT=8086
# GATEWAY_PORT=8080
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Credenciales de los usuarios semilla.
# Los seeders Java las hashean con BCrypt (cost 12) al arrancar auth-service y user-service.
# Vacías = se conservan las contraseñas que vinieron en las migraciones de Flyway.
# ADVERTENCIA: no usar valores reales de producción aquí; son cuentas de demostración.
ADMIN_PASSWORD=
DEMO_PASSWORD=